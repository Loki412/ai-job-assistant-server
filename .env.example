# ---- Server ----
# Leave PORT empty in the cloud: the platform injects it. Locally defaults to 3000.
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to allow all origins (fine for local dev / API-only usage).
# Example: CORS_ORIGIN=https://your-frontend.example.com,https://admin.example.com
CORS_ORIGIN=

# ---- Auth ----
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production

# Set to 1 to include a diagnostic object in 401 responses (token source names
# and lengths only, never the token itself). Use while debugging a client that
# cannot authenticate; leave unset in normal operation.
# AUTH_DEBUG=1

# ---- AI provider (DeepSeek) ----
# REQUIRED for /api/ai, /api/ats, /api/match, /api/optimize, /api/roadmap,
# /api/compare, /api/resume/generate — they all call the LLM.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Database (Supabase) ----
# OPTIONAL. If these are unset (or left as the placeholders below) the app
# automatically falls back to a JSON file store (services/localStore.js).
# That store survives a process restart but is wiped by a fresh deploy, so
# configure Supabase for anything real.
#
# Use the SERVICE ROLE key, not the anon key:
# this server authenticates users with its own JWT, not Supabase Auth, so
# auth.uid() is always NULL in the database. RLS policies written against
# auth.uid() would reject every query and the app would silently fall back to
# the file store. See the header of supabase-migration.sql.
# Find it in Supabase -> Project Settings -> API -> service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Legacy names, accepted as fallbacks (anon key is NOT recommended — see above).
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Only needed for psql / direct Postgres access, not used at runtime.
DATABASE_URL=postgresql://postgres:your_password@db.xxx.supabase.co:5432/postgres

# ---- WeChat Mini Program login (optional) ----
# Without these, POST /api/auth/login runs in demo mode: it returns a demo
# openid instead of a real one. Send a stable `deviceId` in the request body to
# keep the same demo account across logins.
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret
